# Desenvolvimento: copie para apps/server/.env
# Produção (Hostinger): cadastre estas mesmas variáveis no painel, em "Environment variables"

NODE_ENV=development
PORT=3001

# PostgreSQL (opcional: sem ele o jogo funciona só com convidados)
# Supabase: use a "Session pooler" connection string (porta 5432)
DATABASE_URL=postgresql://partyverse:partyverse@localhost:5432/partyverse

# Segredo das sessões: uma string longa e aleatória (mínimo 16 caracteres)
JWT_SECRET=troque-por-uma-string-longa-e-aleatoria

# Endereço do site (em produção: https://seudominio.com.br)
CORS_ORIGINS=http://localhost:5173

# Aplica as tabelas do banco automaticamente ao iniciar
AUTO_MIGRATE=true

# Salas sem atividade são removidas após este tempo (ms)
ROOM_IDLE_TTL_MS=1800000
# Tempo que um jogador desconectado mantém o lugar (ms)
RECONNECT_GRACE_MS=60000

# Login com Google (opcional) — veja DEPLOY-HOSTINGER.md, seção "Login com Google"
# GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxx
# Endereço público do site (usado no retorno do Google)
# PUBLIC_URL=https://seudominio.com.br

# Painel /admin: e-mails das contas administradoras (separados por vírgula)
# ADMIN_EMAILS=voce@exemplo.com

# Recuperar senha por e-mail (Hostinger: smtp.hostinger.com, porta 465)
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# SMTP_USER=contato@seudominio.com.br
# SMTP_PASS=senha-da-caixa
# MAIL_FROM=PartyVerse <contato@seudominio.com.br>

# Desafio do dia com IA (OpenRouter). Sem chave, usa o banco reserva
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_MODEL=minimax/minimax-m3.1-flash:free
