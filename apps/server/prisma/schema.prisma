generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  moduleFormat = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  googleId     String?  @unique
  nickname     String
  avatar       String   @default("blob-1")
  preferences  Json     @default("{}")
  xp           Int      @default(0)
  coins        Int      @default(0)
  banned       Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  stats        UserStats?
  participants MatchParticipant[]
  moderation   ModerationLog[]    @relation("target")
  achievements UserAchievement[]
  sentFriends  Friendship[]       @relation("requester")
  gotFriends   Friendship[]       @relation("addressee")
  resets       PasswordReset[]
  daily        DailyResult[]
  items        UserItem[]
  clan         ClanMember?
}

model UserAchievement {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  code       String
  unlockedAt DateTime @default(now())

  @@unique([userId, code])
}

model Friendship {
  id          String   @id @default(cuid())
  requesterId String
  requester   User     @relation("requester", fields: [requesterId], references: [id], onDelete: Cascade)
  addresseeId String
  addressee   User     @relation("addressee", fields: [addresseeId], references: [id], onDelete: Cascade)
  status      String   @default("pending")
  createdAt   DateTime @default(now())

  @@unique([requesterId, addresseeId])
  @@index([addresseeId])
}

model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model DailyResult {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  day       String
  game      String
  score     Int
  data      Json     @default("{}")
  createdAt DateTime @default(now())

  @@unique([userId, day, game])
  @@index([day, game, score])
}

model UserStats {
  userId       String   @id
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  matchesPlayed Int     @default(0)
  wins          Int     @default(0)
  totalScore    Int     @default(0)
  bestScore     Int     @default(0)
  updatedAt     DateTime @updatedAt
}

model Match {
  id         String   @id @default(cuid())
  gameId     String
  roomCode   String
  rounds     Int
  startedAt  DateTime
  endedAt    DateTime
  summary    Json     @default("{}")

  participants MatchParticipant[]

  @@index([gameId, endedAt])
}

model MatchParticipant {
  id        String  @id @default(cuid())
  matchId   String
  match     Match   @relation(fields: [matchId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  nickname  String
  score     Int
  place     Int
  isGuest   Boolean @default(false)

  @@index([userId])
  @@index([matchId])
}

model ModerationLog {
  id        String   @id @default(cuid())
  roomCode  String
  action    String   // kick | report
  targetId  String?
  target    User?    @relation("target", fields: [targetId], references: [id], onDelete: SetNull)
  actorName String
  reason    String?
  createdAt DateTime @default(now())

  @@index([roomCode])
}

/// Conteúdo do Desafio do dia: perguntas do Quiz e letra/categorias da Adedonha
model DailyChallenge {
  day       String   @id
  source    String
  data      Json
  createdAt DateTime @default(now())
}

/// Denúncias de jogadores
model Report {
  id            String   @id @default(cuid())
  reporterId    String
  reporterName  String
  targetId      String
  targetName    String
  targetIsGuest Boolean  @default(false)
  roomCode      String?
  reason        String
  details       String   @default("")
  evidence      Json     @default("[]")
  status        String   @default("open")
  createdAt     DateTime @default(now())

  @@index([status, createdAt])
}

/// Itens comprados na loja
model UserItem {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemId   String
  boughtAt DateTime @default(now())

  @@unique([userId, itemId])
}

/// Prêmios já entregues do torneio da semana
model WeeklyAward {
  id        String   @id @default(cuid())
  week      String
  userId    String
  place     Int
  coins     Int
  createdAt DateTime @default(now())

  @@unique([week, place])
  @@index([userId])
}

model Clan {
  id          String       @id @default(cuid())
  name        String
  tag         String       @unique
  emoji       String
  description String       @default("")
  ownerId     String
  createdAt   DateTime     @default(now())
  members     ClanMember[]
}

model ClanMember {
  id       String   @id @default(cuid())
  clanId   String
  clan     Clan     @relation(fields: [clanId], references: [id], onDelete: Cascade)
  userId   String   @unique
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     String   @default("member")
  joinedAt DateTime @default(now())

  @@index([clanId])
}
